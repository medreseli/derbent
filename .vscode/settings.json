  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontSize": 14,
  "window.zoomLevel": 0,
  "files.exclude": {
    "**/node_modules": true,
    ".wrangler": true
  },
  "files.associations": {
    "wrangler.json": "jsonc"
  },
  "typescript.tsdk": "node_modules/typescript/lib"
}
